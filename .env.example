
# Copy to .env for local development. Hosted environments set these in the host's settings.

# Pooled connection string used by the running app (on Neon: the "-pooler" host).
DATABASE_URL="postgresql://user:password@localhost:5432/windham_portal"

# Direct (non-pooled) connection used by Prisma migrations. Optional locally.
# DIRECT_URL="postgresql://user:password@localhost:5432/windham_portal"

# Signs staff session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# Password given to the demo staff accounts created by `npm run db:seed`.
SEED_STAFF_PASSWORD=""

# Cloudflare Turnstile ("are you human" check on the subscribe form). Leave both empty to turn
# it off. Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
# For local testing, Cloudflare's always-pass test keys are:
#   site key 1x00000000000000000000AA, secret key 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
