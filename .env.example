# Copy to .env for local development. Hosted environments set these in the host's settings.
#
# Pick one of two ways to get a database:
#
#   A. Local Postgres (anyone): create an empty database, put its address below, then run
#      `npm run db:migrate` and `npm run db:seed`.
#
#   B. The shared development database on Neon (needs the owner's Vercel account on the free
#      plan): `vercel link`, then `vercel env pull .env --environment=development --yes`.
#      That writes DATABASE_URL, DATABASE_URL_UNPOOLED, SESSION_SECRET and SEED_STAFF_PASSWORD
#      for you; it already has tables and demo data, so skip db:migrate and db:seed.
#
# Never point a local .env at the production database.

# Pooled connection string used by the running app (on Neon: the "-pooler" host).
DATABASE_URL="postgresql://user:password@localhost:5432/windham_portal"

# Direct (non-pooled) connection used by Prisma migrations and the seed. Optional locally.
# On Neon this is DATABASE_URL_UNPOOLED, which `vercel env pull` sets for you.
# DIRECT_URL="postgresql://user:password@localhost:5432/windham_portal"

# Signs staff session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# Password given to the demo staff accounts created by `npm run db:seed`.
SEED_STAFF_PASSWORD=""
